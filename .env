GOOGLE_CLIENT_ID=INSERT_YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=INSERT_YOUR_GOOGLE_CLIENT_SECRET_HERE
NEXTAUTH_SECRET=secret_tournament_app_12345
NEXTAUTH_URL=https://ditt-domene.com
DEBUG=false
SUPER_USER=user@email.com

# Prisma SQLite connection string.
# Local default (schema-relative): prisma/dev.db
DATABASE_URL="file:./dev.db"

# If true, the app will recreate the SQLite DB schema on startup (Prisma db push --force-reset).
# Default: false (keep existing DB file)
DB_RECREATE_ON_DEPLOY=false